# global scratch: run.lock, vllm_releases.json, queue / reproduce logs
.work/
# per-PR scratch: exported baseline / PR-solution trees + solver work dirs (regenerated by run_one.sh)
data/pr_*/work/
# per-PR run logs copied next to the result by record.py (large, machine-local)
data/pr_*/logs/
# python / pytest cruft
.pytest_cache/
__pycache__/
*.pyc
.ipynb_checkpoints/
# a vLLM clone is never needed (the per-PR image clones the commits); ignore a stray ROOT clone.
# anchored so solver solution overlays under data/pr_*/files/<arm>/vllm/ stay tracked (GPU box applies them).
/vllm/
# shared model weights, fetch-on-demand per cluster (download.sh), never committed
.weights/
# runner / dashboard logs
.work_build_*.log
.serve.log
# aggregate dir: only all.json + manifest.json are tracked
results/.lock
results/.tmp-*
workloads.json.local-backup
