# LEGACY TEMPLATE — not built by anything. run_one.sh builds ONLY the per-PR
# data/pr_<n>/workload/<hw-slug>/Dockerfile that gen/gen_workloads.py renders from
# templates/Dockerfile.gpu-wheel + task.json. Kept as a reference recipe only.
#
# vLLM GPU image for Ubuntu + NVIDIA RTX 3060 Ti (Ampere, sm_86, 8 GB).
# Builds vLLM from source at a task's base_sha. Pure-python PRs then swap .py
# trees for gold/solver arms at run time (no recompile).
#
# Build:
#   docker build -t vllm-task:<pr> -f Dockerfile.gpu \
#       --build-arg SRC_DIR=.work/pr_<pr>/base_full \
#       --build-arg PRETEND_VERSION=<x.y.z> .
#
# Requires: nvidia-container-toolkit on the host; run with `--gpus all`.
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y \
    && apt-get install -y git ccache python3 python3-pip python3-dev \
       build-essential ninja-build \
    && rm -rf /var/lib/apt/lists/*

# 3060 Ti is Ampere sm_86. Limit arch list to keep the build small/fast.
ENV TORCH_CUDA_ARCH_LIST="8.6"
ENV MAX_JOBS=4
ENV VLLM_TARGET_DEVICE=cuda

ARG SRC_DIR
WORKDIR /workspace/vllm
COPY ${SRC_DIR}/ /workspace/vllm/

RUN pip install --upgrade pip && pip install -r requirements/build.txt
# CUDA torch (cu121). requirements/cuda.txt pins the matching torch.
RUN pip install -v -r requirements/cuda.txt

ARG PRETEND_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${PRETEND_VERSION}
RUN python3 setup.py bdist_wheel && pip install dist/*.whl && rm -rf dist

RUN pip install pytest
WORKDIR /workspace/vllm
ENTRYPOINT ["/bin/bash"]
