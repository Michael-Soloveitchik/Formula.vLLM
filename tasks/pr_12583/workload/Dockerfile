# AUTO-GENERATED by gen_workloads.py — PR #12583 (Expert Parallelism (EP) Support for DeepSeek V2 (#12583))
# Isolated GPU image for THIS PR. vLLM comes from the PyPI wheel (no source build;
# works on GPUs the cu121 source build can't target, e.g. sm_120). The PR's own
# base_sha / merge_sha trees are shallow-fetched INSIDE the image to /base and /gold.
# Arms are .py-tree swaps over the wheel's site-packages (FormulaCode isolation).
# ONLY builds on a CUDA host (run.sh skips this PR when no --gpus is available).
ARG CUDA_TAG=12.8.1-base-ubuntu22.04
FROM nvidia/cuda:${CUDA_TAG}
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-dev git \
 && rm -rf /var/lib/apt/lists/*
# vLLM wheel: first PyPI release AFTER merge_sha (compiled ops match the gold tree).
# Empty VLLM_VERSION = latest (pick one and record it in tasks/pr_12583/metadata.json:wheel).
ARG VLLM_VERSION=
RUN pip install --upgrade pip && pip install "vllm${VLLM_VERSION:+==$VLLM_VERSION}" pytest pytest-asyncio
# Runtime extras in their own layer (keeps the wheel layer cached):
#   gcc/libc6-dev : Triton JIT compiles its CUDA driver shim with a host C compiler
#   tblib         : imported by vLLM's tests/conftest.py (not a vllm dependency)
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/* && pip install tblib
# This PR's trees: shallow-fetch exactly the two commits, export, drop the .git.
ARG BASE_SHA=7940d8a6a7841113c89b168080b51785946f0cdb
ARG MERGE_SHA=781096e385112f799c2b12a9aa2660b85efaf983
RUN set -e; mkdir -p /base /gold /tmp/vllm-git && cd /tmp/vllm-git \
 && git init -q && git remote add origin https://github.com/vllm-project/vllm.git \
 && git fetch -q --depth 1 origin "${BASE_SHA}"  && git archive "${BASE_SHA}"  | tar -x -C /base \
 && git fetch -q --depth 1 origin "${MERGE_SHA}" && git archive "${MERGE_SHA}" | tar -x -C /gold \
 && cd / && rm -rf /tmp/vllm-git \
 && echo "${BASE_SHA}" > /base/.sha && echo "${MERGE_SHA}" > /gold/.sha
WORKDIR /bench
ENTRYPOINT ["/bin/bash"]
