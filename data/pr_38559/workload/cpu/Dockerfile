# CPU MIRROR of templates/Dockerfile.gpu-wheel: same layers, same /base + /gold trees,
# same arm-swap-on-PYTHONPATH isolation — but no CUDA. The PyPI vllm wheel is CUDA-only
# and cannot install on a CPU host, so this image bakes CPU torch + the pure-python deps
# vLLM imports, and the arm's vllm/ .py tree is mounted at runtime (/arm -> /src, PYTHONPATH).
# Pure-python / numpy / numba microbenches (none_cpu cluster) compile and run here; the
# speedup itself is measured on the GPU box. Builds on any arch (arm64 Mac, x86 CI).
FROM python:3.12-slim
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 \
    VLLM_TARGET_DEVICE=cpu
RUN apt-get update && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
# No CUDA vllm wheel on CPU: install CPU torch + the pure-python deps the vLLM import
# chain and benchmarks/ scripts need (mirror of the gpu template's wheel + pytest/tabulate/pandas/datasets).
ARG VLLM_VERSION=0.19.0
RUN pip install --upgrade pip \
 && pip install --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install pytest pytest-asyncio tabulate pandas datasets \
      numpy pydantic psutil cloudpickle msgspec typing_extensions transformers \
      regex filelock huggingface_hub cachetools py-cpuinfo prometheus_client requests
# Optional torch swap (kept for parity with the gpu template; usually empty on CPU):
ARG TORCH_FIX=""
RUN [ -z "$TORCH_FIX" ] || pip install --force-reinstall $TORCH_FIX
# Optional extra pins/packages the bench or tests need (task.json:"extra_pip", e.g. "numba"):
ARG EXTRA_PIP=""
RUN [ -z "$EXTRA_PIP" ] || pip install $EXTRA_PIP
# tblib: imported by vLLM's tests/conftest.py (not a vllm dependency). No gcc/Triton layer: CPU has no CUDA shim.
RUN pip install tblib
# This PR's trees: shallow-fetch exactly the two commits, export, drop the .git.
ARG BASE_SHA=17b72fd1c8052f7a674056b2228a6e7ebfd4f123
ARG MERGE_SHA=7b01d97a22c977aaad2f38fa03cd11742d2893e8
RUN set -e; mkdir -p /base /gold /tmp/vllm-git && cd /tmp/vllm-git \
 && git init -q && git remote add origin https://github.com/vllm-project/vllm.git \
 && git fetch -q --depth 1 origin "${BASE_SHA}"  && git archive "${BASE_SHA}"  | tar -x -C /base \
 && git fetch -q --depth 1 origin "${MERGE_SHA}" && git archive "${MERGE_SHA}" | tar -x -C /gold \
 && cd / && rm -rf /tmp/vllm-git \
 && echo "${BASE_SHA}" > /base/.sha && echo "${MERGE_SHA}" > /gold/.sha
WORKDIR /bench
